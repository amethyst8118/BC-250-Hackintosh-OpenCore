-#define TEST_MODE 0
+// Determine desired cores (6 or 8).
+// 1. Check driver LoadOptions (e.g. "cores=6" or "cores=8")
+// 2. Check NVRAM boot-args (e.g. "bc250cores=6" or "bc250cores=8")
+// 3. Default to 8 cores (Option A requested for this board)
+static int get_requested_cores(EFI_HANDLE ImageHandle, EFI_SYSTEM_TABLE *SystemTable) {
+    int requested = 8; // Default to 8 cores
+
+    // 1. Check LoadOptions from OpenCore Drivers argument
+    EFI_GUID lip_guid = EFI_LOADED_IMAGE_PROTOCOL_GUID;
+    EFI_LOADED_IMAGE_PROTOCOL *lip = NULL;
+    if (SystemTable->BootServices->HandleProtocol(ImageHandle, &lip_guid, (VOID **)&lip) == EFI_SUCCESS && lip) {
+        if (lip->LoadOptions && lip->LoadOptionsSize > 0) {
+            CHAR16 *opt = (CHAR16 *)lip->LoadOptions;
+            UINTN len = lip->LoadOptionsSize / sizeof(CHAR16);
+            for (UINTN i = 0; i < len; i++) {
+                if (opt[i] == L'6') {
+                    requested = 6;
+                } else if (opt[i] == L'8') {
+                    requested = 8;
+                }
+            }
+        }
+    }
+
+    // 2. Check NVRAM boot-args
+    EFI_GUID apple_guid = {0x7C436110, 0xAB2A, 0x4BBB, {0xA8, 0x80, 0xFE, 0x41, 0x99, 0x5C, 0x9F, 0x82}};
+    CHAR8 boot_args[1024];
+    UINTN sz = sizeof(boot_args) - 1;
+    EFI_STATUS status = SystemTable->RuntimeServices->GetVariable(
+        L"boot-args",
+        &apple_guid,
+        NULL,
+        &sz,
+        boot_args
+    );
+    if (status == EFI_SUCCESS && sz > 0) {
+        boot_args[sz] = '\0';
+        for (UINTN i = 0; i + 12 <= sz; i++) {
+            if (boot_args[i]   == 'b' && boot_args[i+1] == 'c' &&
+                boot_args[i+2] == '2' && boot_args[i+3] == '5' &&
+                boot_args[i+4] == '0' && boot_args[i+5] == 'c' &&
+                boot_args[i+6] == 'o' && boot_args[i+7] == 'r' &&
+                boot_args[i+8] == 'e' && boot_args[i+9] == 's' &&
+                boot_args[i+10] == '=') {
+                if (boot_args[i+11] == '6') requested = 6;
+                else if (boot_args[i+11] == '8') requested = 8;
+            }
+        }
+    }
+
+    return requested;
+}
 
